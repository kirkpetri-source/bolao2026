# ─── Firebase (frontend — chaves públicas por natureza) ───────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Segredos de servidor (NUNCA prefixar com VITE_ — vazaria no bundle) ───────
# Autenticação dos endpoints de cron/serverless. Gere um valor forte e único.
CRON_SECRET=

# Service account do Firebase (JSON em UMA linha) para o Admin SDK no backend
# (crons, webhook Woovi, /api/auth/forgot-password, /api/admin/update-user).
# Gere em: Console → Configurações → Contas de serviço → Gerar nova chave.
# Em produção, defina na Vercel (Sensitive). Em dev, pode usar serviceAccountKey.json na raiz.
FIREBASE_SERVICE_ACCOUNT=

# EvolutionAPI (WhatsApp)
EVOLUTION_LINK=
EVOLUTION_INSTANCE=
EVOLUTION_TOKEN=
EVOLUTION_VERIFY_TLS=true
EVOLUTION_ALLOW_HTTP_UPSTREAM=false

# Woovi / OpenPix
WOOVI_APP_ID=

# API-Football (placares ao vivo)
APIFOOTBALL_KEY=

# URL pública do app (usada em links do ranking nas mensagens)
APP_URL=

# WhatsApp do admin (fallback quando não há grupo configurado)
ADMIN_WHATSAPP_NUMBER=
