rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// REGRAS MULTI-TENANT (RASCUNHO — NÃO DEPLOYADO)
// Alvo da Fase 2 do SaaS. Só entra no cutover, junto com o app reescrito para
// filtrar por tenantId e a migração (scripts/migrate-to-multitenant.mjs --commit).
//
// Modelo:
//  - Pertencimento: doc em /tenants/{tid}/members/{uid} (role: 'owner'|'participant').
//  - Docs escopados têm campo tenantId. Usuário só acessa dados de tenants a que pertence.
//  - Nomes dos participantes vêm de members (não da coleção global /users).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function memberPath(tid) {
      return /databases/$(database)/documents/tenants/$(tid)/members/$(request.auth.uid);
    }
    function isMember(tid) {
      return isSignedIn() && exists(memberPath(tid));
    }
    function isOwner(tid) {
      return isMember(tid) && get(memberPath(tid)).data.role == 'owner';
    }

    // ── Tenants e membros ─────────────────────────────────────────────────────
    match /tenants/{tid} {
      allow get: if isMember(tid);
      allow list: if false;                 // sem varredura global de tenants
      allow create, update, delete: if false; // criado/gerido via Admin SDK (onboarding/billing)

      match /members/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isOwner(tid));
        allow list: if isMember(tid);        // ranking/lista de participantes do tenant
        allow write: if isOwner(tid);        // owner gere membros (ou via Admin SDK)
      }
    }

    // ── Identidade global (não escopada) ──────────────────────────────────────
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId; // só o próprio
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.isAdmin == false;
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'balance', 'password']);
      allow delete: if false;
    }

    // ── Coleções escopadas por tenant ─────────────────────────────────────────
    match /rounds/{id} {
      allow read:   if isMember(resource.data.tenantId);
      allow create: if isOwner(request.resource.data.tenantId);
      allow update, delete: if isOwner(resource.data.tenantId);
    }

    match /predictions/{id} {
      allow read: if isMember(resource.data.tenantId);
      allow create: if isMember(request.resource.data.tenantId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paid == false;
      allow update: if isOwner(resource.data.tenantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paid','statusPagamento','dataPagamento']));
      allow delete: if isOwner(resource.data.tenantId)
        || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.paid == false);
    }

    match /establishments/{id} {
      allow read:  if isMember(resource.data.tenantId);
      allow write: if isOwner(request.resource.data.tenantId) || isOwner(resource.data.tenantId);
    }

    match /communications/{id} {
      allow read, write: if isOwner(resource.data.tenantId) || isOwner(request.resource.data.tenantId);
    }

    // Settings por tenant (contém segredos): só o owner.
    match /settings/{id} {
      allow read, write: if isOwner(resource.data.tenantId) || isOwner(request.resource.data.tenantId);
    }

    // Config pública por tenant (branding/valor): leitura pública (tela de entrada),
    // escrita só do owner.
    match /public_config/{id} {
      allow read: if true;
      allow write: if isOwner(resource.data.tenantId) || isOwner(request.resource.data.tenantId);
    }

    // ── Auditoria/analytics/infra: via Admin SDK (backend) ────────────────────
    match /user_events/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }
    match /admin_events/{id}   { allow read: if false; allow write: if false; }
    match /audit_logs/{id}     { allow read: if false; allow write: if false; }
    match /settings_history/{id} { allow read: if false; allow write: if false; }
    match /logs/{id}           { allow read: if false; allow write: if false; }
    match /transactions/{id}   { allow read: if false; allow write: if false; }
    match /rate_limits/{id}    { allow read, write: if false; }

    // Times: catálogo compartilhado (leitura para autenticados; escrita via Admin SDK).
    match /teams/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Bloqueio padrão.
    match /{document=**} { allow read, write: if false; }
  }
}
