rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Regras de segurança do Firestore — Bolão Brasileirão (multi-tenant, Fase 2)
//
// Modelo de identidade:
//  - Autenticação via Firebase Auth (email sintético derivado do WhatsApp).
//  - O uid do Auth É IGUAL ao ID do documento em /users.
//
// Modelo multi-tenant:
//  - Pertencimento: doc em /tenants/{tid}/members/{uid} (role: 'owner'|'participant').
//  - Docs escopados (rounds, predictions, establishments, communications,
//    settings, public_config) têm campo tenantId. Toda LISTA precisa filtrar
//    por tenantId — queries sem filtro são negadas.
//  - Cadastro público: o próprio usuário cria seu doc em /users e faz
//    self-join no tenant com role 'participant'.
//
// Paridade preservada (endurecer quando o onboarding de novos tenants entrar):
//  - /users NÃO é listável: a lista de participantes sai de
//    /tenants/{tid}/members, que carrega nome, whatsapp e e-mail.
//  - Dois papéis distintos: operador da plataforma (users.platformAdmin) e
//    dono de bolão (members.role == 'owner'). Ver isPlatformAdmin/isOwner.
//  - /establishments e /public_config: leitura pública (telas pré-login).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Dois papéis, de propósito ───────────────────────────────────────────
    // OPERADOR DA PLATAFORMA: cuida do SaaS (catálogo de times, auditoria,
    // visibilidade de qualquer bolão para suporte). É a Lion Tech.
    // DONO DE BOLÃO: cuida do próprio bolão e dos participantes DELE.
    //
    // Antes os dois compartilhavam a flag `isAdmin`, e por isso um bolão só
    // funcionava direito se o dono fosse a própria plataforma — o dono comum
    // levava 403 ao tentar editar um participante do bolão dele.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isPlatformAdmin() {
      return isSignedIn()
        && (request.auth.token.platformAdmin == true
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && userDoc().get('platformAdmin', false) == true));
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function memberPath(tid) {
      return /databases/$(database)/documents/tenants/$(tid)/members/$(request.auth.uid);
    }
    function isMember(tid) {
      return isSignedIn() && exists(memberPath(tid));
    }
    function isOwner(tid) {
      return isMember(tid) && get(memberPath(tid)).data.role == 'owner';
    }

    // O dono da plataforma precisa ENXERGAR qualquer bolão para dar suporte —
    // sem isto ele abre um bolão de cliente e vê tudo vazio, porque as regras
    // pedem pertencimento e ele só é membro do próprio. Leitura apenas: alterar
    // dado de cliente continua exigindo ser owner daquele bolão.
    function podeVerTenant(tid) {
      return isMember(tid) || isPlatformAdmin();
    }

    // O alvo pertence a um bolão que eu sou dono? É assim que o dono gerencia
    // os participantes DELE sem enxergar os dos outros.
    function souDonoDoBolaoDe(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId))
        && isOwner(get(/databases/$(database)/documents/users/$(userId)).data.get('lastTenantId', ''))
        && exists(/databases/$(database)/documents/tenants/$(get(/databases/$(database)/documents/users/$(userId)).data.get('lastTenantId', ''))/members/$(userId));
    }

    // Assinatura do bolão com a plataforma. Quem não paga fica bloqueado, e
    // aqui é o único lugar que o cliente não contorna: o painel apenas espelha
    // esta decisão. O status é escrito pelo cron de billing (Admin SDK).
    function tenantBlocked(tid) {
      return exists(/databases/$(database)/documents/tenants/$(tid))
        && get(/databases/$(database)/documents/tenants/$(tid)).data.get('subscription', {}).get('status', 'trial') == 'blocked';
    }

    // Campos que o próprio usuário NÃO pode alterar em si mesmo.
    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'balance', 'password']);
    }

    // ── Tenants e membros ───────────────────────────────────────────────────
    match /tenants/{tid} {
      allow get: if podeVerTenant(tid);
      allow list: if false;                   // sem varredura global de tenants
      allow create, update, delete: if false; // gestão via Admin SDK (onboarding/billing)

      match /members/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isOwner(tid));
        allow list: if podeVerTenant(tid);
        // Owner gere membros; cadastro público faz self-join como participant.
        allow create: if isOwner(tid)
          || (isSelf(uid) && request.resource.data.role == 'participant');
        allow update, delete: if isOwner(tid);
      }
    }

    // ── Usuários (identidade global) ────────────────────────────────────────
    // /users é GLOBAL: sem tenantId, junta gente de todos os bolões. Listar
    // essa coleção entregava nome e WhatsApp de todos os clientes a qualquer
    // autenticado. A lista de participantes passou a sair de
    // /tenants/{tid}/members, que já é escopada — aqui a varredura é negada.
    match /users/{userId} {
      allow get: if isSelf(userId) || isPlatformAdmin() || souDonoDoBolaoDe(userId);
      allow list: if isPlatformAdmin();

      // Criação: o usuário cria o próprio doc no cadastro (uid == doc id) e
      // nunca pode se autodeclarar admin. O dono cria participantes do bolão
      // dele; a plataforma cria qualquer um.
      allow create: if isPlatformAdmin()
        || (isSelf(userId) && request.resource.data.isAdmin == false)
        || (isOwner(request.resource.data.get('lastTenantId', ''))
            && request.resource.data.isAdmin == false);

      // Update: plataforma livre; dono nos participantes do bolão dele; o
      // próprio usuário só nos campos não sensíveis.
      allow update: if isPlatformAdmin()
        || (souDonoDoBolaoDe(userId) && protectedUserFieldsUnchanged())
        || (isSelf(userId) && protectedUserFieldsUnchanged());

      // Exclusão passa por api/admin/delete-user, que apaga também a conta no
      // Auth e libera o e-mail — apagar só o doc daqui deixaria conta órfã.
      allow delete: if isPlatformAdmin();
    }

    // ── Rodadas (escopadas por tenant) ──────────────────────────────────────
    // Bolão bloqueado continua legível — o organizador entra e vê o histórico —
    // mas não abre nem edita rodada até pagar. É isso que trava a operação dele
    // sem trancá-lo para fora da própria conta.
    match /rounds/{doc} {
      allow read: if podeVerTenant(resource.data.tenantId);
      allow create: if isOwner(request.resource.data.tenantId)
        && !tenantBlocked(request.resource.data.tenantId);
      allow update: if isOwner(resource.data.tenantId)
        && !tenantBlocked(resource.data.tenantId);
      allow delete: if isOwner(resource.data.tenantId);
    }

    // ── Palpites (escopados por tenant) ─────────────────────────────────────
    match /predictions/{predId} {
      allow read: if podeVerTenant(resource.data.tenantId);

      // Membro cria palpite em seu próprio nome e NUNCA marca como pago.
      // Owner pode criar em nome de qualquer participante.
      // Bolão com assinatura bloqueada não recebe palpite de ninguém.
      allow create: if !tenantBlocked(request.resource.data.tenantId)
        && (isOwner(request.resource.data.tenantId)
            || (isMember(request.resource.data.tenantId)
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.paid == false));

      // Update do próprio palpite sem mexer no status de pagamento (e sem
      // trocar de tenant). O 'pago' só muda via owner ou webhook (Admin SDK).
      allow update: if !tenantBlocked(resource.data.tenantId)
        && (isOwner(resource.data.tenantId)
            || (isSignedIn()
                && resource.data.userId == request.auth.uid
                && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['paid', 'statusPagamento', 'dataPagamento', 'tenantId'])));

      allow delete: if isOwner(resource.data.tenantId)
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.paid == false);
    }

    // ── Estabelecimentos: leitura pública (formulário de cadastro, pré-login) ─
    match /establishments/{doc} {
      allow read: if true;
      allow write: if isOwner(request.resource.data.tenantId) || isOwner(resource.data.tenantId);
    }

    // ── Comunicados: só o owner do tenant ───────────────────────────────────
    match /communications/{doc} {
      allow read: if isOwner(resource.data.tenantId) || isPlatformAdmin();
      allow write: if isOwner(request.resource.data.tenantId) || isOwner(resource.data.tenantId);
    }

    // ── Configurações (contêm segredos Woovi/Evolution): só o owner ─────────
    match /settings/{doc} {
      allow read: if isOwner(resource.data.tenantId) || isPlatformAdmin();
      allow write: if isOwner(request.resource.data.tenantId) || isOwner(resource.data.tenantId);
    }

    // ── Config pública (sem segredos): leitura pública, escrita do owner ────
    match /public_config/{doc} {
      allow read: if true;
      allow write: if isOwner(request.resource.data.tenantId) || isOwner(resource.data.tenantId);
    }

    // ── Times: catálogo global compartilhado ────────────────────────────────
    match /teams/{doc} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // Pedidos de importação de times: apenas admin global.
    match /team_import_requests/{doc} {
      allow read, write: if isPlatformAdmin();
    }

    // ── Eventos de uso/analytics gravados pelo cliente (não sensíveis) ──────
    match /user_events/{doc} {
      allow read: if isPlatformAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Logs/auditoria/histórico do painel: só admin lê e cria ──────────────
    // Sem update/delete (integridade do histórico).
    match /admin_events/{doc} {
      // O dono registra as ações do bolão dele; a plataforma lê tudo. Antes só
      // o admin global gravava, então owner nenhum conseguia deixar auditoria.
      allow read: if isPlatformAdmin() || isOwner(resource.data.get('tenantId', ''));
      allow create: if isPlatformAdmin() || isOwner(request.resource.data.get('tenantId', ''));
      allow update, delete: if false;
    }
    match /audit_logs/{doc} {
      allow read, create: if isPlatformAdmin();
      allow update, delete: if false;
    }
    match /settings_history/{doc} {
      // O dono registra as ações do bolão dele; a plataforma lê tudo. Antes só
      // o admin global gravava, então owner nenhum conseguia deixar auditoria.
      allow read: if isPlatformAdmin() || isOwner(resource.data.get('tenantId', ''));
      allow create: if isPlatformAdmin() || isOwner(request.resource.data.get('tenantId', ''));
      allow update, delete: if false;
    }
    match /logs/{doc} {
      // O dono registra as ações do bolão dele; a plataforma lê tudo. Antes só
      // o admin global gravava, então owner nenhum conseguia deixar auditoria.
      allow read: if isPlatformAdmin() || isOwner(resource.data.get('tenantId', ''));
      allow create: if isPlatformAdmin() || isOwner(request.resource.data.get('tenantId', ''));
      allow update, delete: if false;
    }

    // Transações de pagamento: leitura só admin; escrita via serverless.
    match /transactions/{doc} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /rate_limits/{doc} {
      allow read, write: if false;
    }

    // Índice de unicidade de e-mail do organizador: só o Admin SDK escreve, e
    // ninguém lista (a coleção mapearia e-mails de todos os clientes).
    match /email_index/{doc} {
      allow read, write: if false;
    }

    // Qualquer coleção não declarada acima fica bloqueada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
